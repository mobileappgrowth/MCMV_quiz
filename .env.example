# Painel do Supabase > Project Settings > API

# Publicas: vao para o navegador. Usadas somente para autenticacao (magic link).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA: bypassa RLS. Existe apenas no servidor.
# NUNCA renomeie com prefixo NEXT_PUBLIC_. NUNCA importe em componente de cliente.
SUPABASE_SERVICE_ROLE_KEY=


# Emails com acesso ao /admin, separados por virgula. Voce e o unico hoje.
# Sem tabela de papeis: uma string aqui e mais facil de auditar.
ADMIN_EMAILS=
